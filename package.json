{
  "name": "quran-epub-builder",
  "version": "1.0.0",
  "description": "Builds two polished Mushaf-style EPUB 3 files (Arabic-only Uthmani, and Indonesian Kemenag) from the quran.com API v4.",
  "type": "commonjs",
  "main": "builder.js",
  "scripts": {
    "build": "node builder.js",
    "build:arab": "node builder.js --only=arab",
    "build:indopak": "node builder.js --only=indopak",
    "validate": "node validate.js",
    "check": "epubcheck \"dist/Al-Quran (Uthmani Format).epub\" && epubcheck \"dist/Al-Quran (IndoPak Format).epub\""
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "jszip": "^3.10.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
