{
  "name": "quran-epub-builder",
  "version": "1.0.0",
  "description": "Builds two polished Mushaf-style EPUB 3 files (Arabic-only Uthmani, and Indonesian Kemenag) from the quran.com API v4.",
  "type": "commonjs",
  "main": "builder.js",
  "scripts": {
    "build": "node builder.js",
    "build:arab": "node builder.js --only=arab",
    "build:indopak": "node builder.js --only=indopak",
    "build:clara-pdf": "node build-clara-pdf.js",
    "build:x4-epub": "node build-x4-epub.js",
    "build:x4-kemenag": "node build-x4-kemenag-epub.js",
    "build:x4-pdf": "node build-xteink-pdf.js x4",
    "build:x3-pdf": "node build-xteink-pdf.js x3",
    "build:xteink-pdf": "node build-xteink-pdf.js all",
    "build:epub-pdf": "node build-epub-pdf.js all",
    "build:dzikir-pdf": "node build-epub-pdf.js dzikir",
    "build:juzamma-pdf": "node build-epub-pdf.js juzamma",
    "build:x4-pdf": "node build-epub-pdf.js all x4",
    "build:x4-dzikir-pdf": "node build-epub-pdf.js dzikir x4",
    "build:x4-juzamma-pdf": "node build-epub-pdf.js juzamma x4",
    "build:clara-kepub": "node build-clara-kepub.js",
    "build:x4-books": "node build-x4-books.js all",
    "build:x4-dzikir-epub": "node build-x4-books.js dzikir",
    "build:x4-juzamma-epub": "node build-x4-books.js juzamma",
    "build:x4": "node build-x4-epub.js && node build-xteink-pdf.js x4",
    "preview:x4": "node preview-xteink.js x4",
    "preview:x3": "node preview-xteink.js x3",
    "validate": "node validate.js",
    "check": "epubcheck \"dist/Al-Quran/epub/Universal/Al-Quran (Uthmani Format).epub\" && epubcheck \"dist/Al-Quran/epub/Universal/Al-Quran (IndoPak Format).epub\""
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "jszip": "^3.10.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
