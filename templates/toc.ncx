<!-- =========================================================================
  REFERENCE TEMPLATE — toc.ncx (EPUB 2 / legacy Kindle navigation)
  Required so older Kindle firmware and "Send to Kindle" conversions still get
  a working nested Juz → Surah menu. builder.js generates the full tree with
  monotonic playOrder values.
========================================================================== -->
<!DOCTYPE ncx PUBLIC "-//NISO//DTD ncx 2005-1//EN"
  "http://www.daisy.org/z3986/2005/ncx-2005-1.dtd">
<ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1" xml:lang="ar">
  <head>
    <meta name="dtb:uid" content="urn:uuid:REPLACED-PER-EDITION"/>
    <meta name="dtb:depth" content="2"/>
    <meta name="dtb:totalPageCount" content="0"/>
    <meta name="dtb:maxPageNumber" content="0"/>
  </head>
  <docTitle><text>القرآن الكريم</text></docTitle>
  <navMap>
    <navPoint id="np-juz-1" playOrder="1">
      <navLabel><text>Juz 1 — الجزء ١</text></navLabel>
      <content src="text/surah-001.xhtml#ayah-1-1"/>
      <navPoint id="np-1-1" playOrder="2">
        <navLabel><text>1. Al-Fatihah</text></navLabel>
        <content src="text/surah-001.xhtml#ayah-1-1"/>
      </navPoint>
      <navPoint id="np-1-2" playOrder="3">
        <navLabel><text>2. Al-Baqarah</text></navLabel>
        <content src="text/surah-002.xhtml#ayah-2-1"/>
      </navPoint>
    </navPoint>
    <!-- … Juz 2 … Juz 30 … -->
  </navMap>
</ncx>
